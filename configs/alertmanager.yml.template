global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by: ['alertname', 'job']
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token_file: /run/secrets/telegram_bot_token
        chat_id: ${TELEGRAM_CHAT_ID}
        send_resolved: true
